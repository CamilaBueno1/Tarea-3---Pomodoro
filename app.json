{
  "expo": {
    "name": "pomodoro-cotopaxi",
    "slug": "pomodoro-cotopaxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cotopaxi-logo.jpg",
    "scheme": "pomodorocotopaxi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/cotopaxi-logo.jpg",
        "backgroundImage": "./assets/images/cotopaxi-logo.jpg",
        "monochromeImage": "./assets/images/cotopaxi-logo.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.pomodorocotopaxi"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-image",
      "expo-notifications",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a4aa7766-17a1-4031-8557-7918b4dc25f2"
      }
    },
    "owner": "camilabuenor"
  }
}
